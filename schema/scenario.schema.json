{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidjones-griz/fake-llm/main/schema/scenario.schema.json",
  "$comment": "Generated from openapi/fake-llm.yaml by ./gradlew updateScenarioSchema. Do not edit by hand.",
  "title": "fake-llm scenario",
  "type": "object",
  "description": "One named behaviour: an ordered list of steps. After a load or reset, call N gets step N.\nA call after the last step gets `NoMoreStepsError`.\n",
  "required": [
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The scenario JSON Schema's URL or path, for editors (see `schema/scenario.schema.json`).\nIgnored by the server. Only at the top level, not in a step.\n"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "$defs": {
    "Step": {
      "type": "object",
      "description": "One scripted reply: a reply (`text`, `toolCalls` or both, optionally with `thinking`), or a\nscripted `error`. A step sets exactly one of a reply and `error`.\n",
      "additionalProperties": false,
      "oneOf": [
        {
          "anyOf": [
            {
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "toolCalls"
              ],
              "properties": {
                "toolCalls": {
                  "type": "array"
                }
              }
            }
          ]
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "thinking"
            ],
            "properties": {
              "thinking": {
                "type": "string"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "toolCalls"
                ],
                "properties": {
                  "toolCalls": {
                    "type": "array"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "toolCalls"
            ],
            "properties": {
              "toolCalls": {
                "type": "array"
              }
            }
          },
          "then": {
            "properties": {
              "stopReason": {
                "enum": [
                  "end_turn",
                  "tool_use"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "streamErrorAfterChunks"
            ],
            "properties": {
              "streamErrorAfterChunks": {
                "type": "integer"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ],
          "description": "An Anthropic thinking block, before the text and tool calls. Only on a reply step."
        },
        "stopReason": {
          "type": "string",
          "default": "end_turn",
          "description": "The `stop_reason` of a reply; `max_tokens` reports a truncated reply. On a step with\n`toolCalls` it must be `end_turn` or `tool_use`, and every format reports a tool-call stop.\n"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorStep"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamChunkChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 24,
          "description": "Size of each streamed delta, in Unicode code points (Anthropic and OpenAI streams)."
        },
        "streamInterChunkDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "default": 0,
          "description": "Milliseconds to wait before each streamed delta (Anthropic and OpenAI streams)."
        },
        "streamErrorAfterChunks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Only on an error step, and only when streamed (Anthropic or OpenAI): send this many text\ndeltas, then an in-stream error.\n"
        },
        "toolCalls": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "description": "Tool calls the reply makes, in order, after any `text`."
        }
      }
    },
    "ErrorStep": {
      "type": "object",
      "description": "A scripted HTTP error in place of a reply.",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body": {
          "type": "string",
          "default": "",
          "description": "The response body, sent as given."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra response headers, such as `retry-after`, sent as given."
        }
      }
    },
    "ToolCall": {
      "type": "object",
      "description": "One scripted tool call.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "arguments",
          "rawArguments"
        ],
        "properties": {
          "arguments": {
            "type": "object"
          },
          "rawArguments": {
            "type": "string"
          }
        }
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The tool's name, sent as given."
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "description": "The arguments as a JSON object. With `rawArguments` also unset, `{}`."
        },
        "rawArguments": {
          "type": [
            "string",
            "null"
          ],
          "description": "The argument text, sent verbatim: invalid JSON is allowed. Only the OpenAI format and a\nstreamed Anthropic reply carry it; a buffered Anthropic or a Gemini request whose next step\nhas it gets `ExceptionError`, and the step is not used.\n"
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The call's id. Default: `toolu_fake_<seq>_<n>` (Anthropic) and `call_fake_<seq>_<n>`\n(OpenAI), where `n` is the call's 1-based position in the step. Gemini sends an id only when\none is set.\n"
        }
      }
    }
  }
}
