{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidjones-griz/fake-llm/main/schema/scenario.schema.json",
  "$comment": "Generated from openapi/fake-llm.yaml by ./gradlew updateScenarioSchema. Do not edit by hand.",
  "title": "fake-llm scenario",
  "type": "object",
  "description": "One behaviour: an ordered list of steps. After a load or reset, call N gets step N, in a\nscenario with no `match`, no parallel step and no `times`.\nA call after the last step gets `NoMoreStepsError`. A load by name finds the file by its\nfile name; `metadata.name` is a display name. Before 0.8.0 `name` and `description` were\ntop-level keys; they are now in `metadata`, and a top-level one is rejected.\n",
  "required": [
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The scenario JSON Schema's URL or path, for editors (see `schema/scenario.schema.json`).\nIgnored by the server. Only at the top level, not in a step.\n"
    },
    "metadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScenarioMetadata"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the scenario is called and for. `name` defaults to the file name for a load by\nname; an inline load with no `name` is identified as `inline`.\n"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "$defs": {
    "ScenarioMetadata": {
      "type": "object",
      "description": "Information about a scenario or a step: what it is called, why it exists, and labels for\nfinding it. It never changes how a scenario runs: matching, replies, order and pass/fail are\nthe same with or without it. Only these fields are defined; any other key is rejected. It is\nnot allowed inside `match`, `error`, `toolCalls` or any other part of a step.\n",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S",
          "description": "Not empty or blank. A display name. On a step, it is copied into the call log and named in unused-step\nreports; names need not be unique. On a scenario, it is shown beside the file name, and\nidentifies an inline load.\n"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "A note for people reading the scenario, such as why a group runs in parallel."
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Labels for search and filtering, none empty or blank. Null, like an absent key, is none.\nThe server does not act on them; the JUnit extension selects tests by a scenario's\ntop-level tags.\n"
        }
      }
    },
    "Step": {
      "type": "object",
      "description": "One scripted reply: a reply (`text`, `toolCalls` or both, optionally with `thinking` and\n`usage`), or a scripted `error`, optionally with a `match` and `times`; or a parallel step, an object\nwhose only keys are `parallel` and `metadata`. A step sets exactly one of a reply, `error` and\n`parallel`. Any step can carry `metadata`.\n",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "parallel"
          ],
          "properties": {
            "parallel": {
              "type": "object"
            }
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "toolCalls"
              ],
              "properties": {
                "toolCalls": {
                  "type": "array"
                }
              }
            }
          ]
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "parallel"
            ],
            "properties": {
              "parallel": {
                "type": "object"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "parallel",
                "metadata"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "thinking"
            ],
            "properties": {
              "thinking": {
                "type": "string"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "toolCalls"
                ],
                "properties": {
                  "toolCalls": {
                    "type": "array"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "usage"
            ],
            "properties": {
              "usage": {
                "type": "object"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "toolCalls"
                ],
                "properties": {
                  "toolCalls": {
                    "type": "array"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "toolCalls"
            ],
            "properties": {
              "toolCalls": {
                "type": "array"
              }
            }
          },
          "then": {
            "properties": {
              "stopReason": {
                "enum": [
                  "end_turn",
                  "tool_use"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "streamErrorAfterChunks"
            ],
            "properties": {
              "streamErrorAfterChunks": {
                "type": "integer"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "stopSequence"
            ],
            "properties": {
              "stopSequence": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "stopReason"
            ],
            "properties": {
              "stopReason": {
                "const": "stop_sequence"
              }
            }
          }
        }
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ],
          "description": "An Anthropic thinking block, or an OpenAI Responses `reasoning` output item (`rs_fake_<n>`, one `summary_text` part), before the text and tool calls. Only on a reply step. Ignored by OpenAI Chat Completions and Gemini."
        },
        "stopReason": {
          "type": "string",
          "default": "end_turn",
          "description": "The `stop_reason` of a reply; `max_tokens` reports a truncated reply. On a step with\n`toolCalls` it must be `end_turn` or `tool_use`, and every format with a stop reason\nreports a tool-call stop; an OpenAI Responses reply with tool calls is `completed`.\n`max_tokens` is an `incomplete` OpenAI Responses reply (`max_output_tokens`).\n`stop_sequence` reports a matched stop sequence; set `stopSequence` to say which.\n"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorStep"
            },
            {
              "type": "null"
            }
          ]
        },
        "streamChunkChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 24,
          "description": "Size of each streamed delta, in Unicode code points (Anthropic, OpenAI Chat Completions and\nResponses, and Gemini streams).\n"
        },
        "streamInterChunkDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000,
          "default": 0,
          "description": "Milliseconds to wait before each streamed delta (Anthropic, OpenAI Chat Completions and\nResponses, and Gemini streams; a Gemini functionCall chunk has no wait). At most 600000\n(10 minutes).\n"
        },
        "streamErrorAfterChunks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Only on an error step, and only when streamed (Anthropic, OpenAI Chat Completions and\nResponses, and Gemini): send this many text deltas, then an in-stream error.\n"
        },
        "firstByteDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000,
          "default": 0,
          "description": "Milliseconds to wait before any response bytes, status and headers included (every\ngeneration route; buffered and streamed replies and error steps). The call is numbered\nand logged when it arrives, before the wait. At most 600000 (10 minutes).\n"
        },
        "toolCalls": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "description": "Tool calls the reply makes, in order, after any `text`."
        },
        "usage": {
          "oneOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "The token counts this reply reports. Only on a reply step. Unset counts keep the\ndefaults (100 input, 50 output); totals are the sum; the Anthropic cache figures don't\nchange.\n"
        },
        "stopSequence": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The stop sequence that ended the reply, sent as Anthropic's `stop_sequence` (buffered, and in the stream's `message_delta`). Only with `stopReason` `stop_sequence`. Other formats ignore it."
        },
        "match": {
          "oneOf": [
            {
              "$ref": "#/$defs/Match"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only a call that satisfies it takes this step. On a plain step, a call that doesn't\ngets the `no-match` 400 and the step stays next, unless the step has `times` and its\nminimum, when the call can reach the step after it; in a parallel step, the call looks\nat the section's other steps.\n"
        },
        "parallel": {
          "oneOf": [
            {
              "$ref": "#/$defs/ParallelSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Makes this a parallel step: one position in the scenario holding several responses,\nused in any order. A parallel step has no other key but `metadata`.\n"
        },
        "times": {
          "oneOf": [
            {
              "$ref": "#/$defs/Times"
            },
            {
              "type": "null"
            }
          ],
          "description": "How many calls this step takes. Null, the default, is exactly once. Not on a parallel\nstep; on its steps, yes.\n"
        },
        "metadata": {
          "oneOf": [
            {
              "$ref": "#/$defs/ScenarioMetadata"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the step is called and for. It never changes how the step is served. `name` is\ncopied into the call log's `stepName` when this step answers a call.\n"
        }
      }
    },
    "ErrorStep": {
      "type": "object",
      "description": "A scripted HTTP error in place of a reply.",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "body": {
          "type": "string",
          "default": "",
          "description": "The response body, sent as given."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra response headers, such as `retry-after`, sent as given."
        }
      }
    },
    "ToolCall": {
      "type": "object",
      "description": "One scripted tool call.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "arguments",
          "rawArguments"
        ],
        "properties": {
          "arguments": {
            "type": "object"
          },
          "rawArguments": {
            "type": "string"
          }
        }
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The tool's name, sent as given."
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "description": "The arguments as a JSON object. With `rawArguments` also unset, `{}`."
        },
        "rawArguments": {
          "type": [
            "string",
            "null"
          ],
          "description": "The argument text, sent verbatim: invalid JSON is allowed. Only the OpenAI formats (Chat\nCompletions and Responses) and a streamed Anthropic reply carry it; a buffered Anthropic or a Gemini request whose chosen step\nhas it gets the `unsupported-step` 400 (`RequestError`), and the step stays unused.\n"
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The call's id. Default: `toolu_fake_<seq>_<n>` (Anthropic) and `call_fake_<seq>_<n>`\n(OpenAI; the `call_id` on Responses), where `n` is the call's 1-based position in the step. Gemini sends an id only when\none is set.\n"
        }
      }
    },
    "TokenUsage": {
      "type": "object",
      "description": "Token counts a reply step reports in every vendor's usage fields.",
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 100,
          "description": "Anthropic and Responses `input_tokens`, OpenAI `prompt_tokens`, Gemini `promptTokenCount`."
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 50,
          "description": "Anthropic and Responses `output_tokens`, OpenAI `completion_tokens`, Gemini `candidatesTokenCount`."
        }
      }
    },
    "Match": {
      "type": "object",
      "description": "What a call must look like for a step to answer it. Every key that is set must hold, and at\nleast one must be set.\n",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "route"
          ],
          "properties": {
            "route": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "stream"
          ],
          "properties": {
            "stream": {
              "type": "boolean"
            }
          }
        },
        {
          "required": [
            "system"
          ],
          "properties": {
            "system": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "lastUser"
          ],
          "properties": {
            "lastUser": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "messageCount"
          ],
          "properties": {
            "messageCount": {
              "type": "integer"
            }
          }
        },
        {
          "required": [
            "hasSystem"
          ],
          "properties": {
            "hasSystem": {
              "type": "boolean"
            }
          }
        },
        {
          "required": [
            "toolResult"
          ],
          "properties": {
            "toolResult": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "tools"
          ],
          "properties": {
            "tools": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "body"
          ],
          "properties": {
            "body": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "header"
          ],
          "properties": {
            "header": {
              "type": "object"
            }
          }
        }
      ],
      "properties": {
        "route": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "anthropic",
            "openai",
            "openai-responses",
            "gemini",
            null
          ],
          "description": "The route, as the call log's `vendor` names it."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "The request's model, exactly."
        },
        "stream": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the request asked for a stream."
        },
        "system": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The system prompt's text."
        },
        "lastUser": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text of the last user message that has text."
        },
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request's combined prompt text, of which a call record's `promptSample` is the end."
        },
        "message": {
          "oneOf": [
            {
              "$ref": "#/$defs/MessageMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "One message, by index or by role."
        },
        "messageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647,
          "description": "The number of messages."
        },
        "hasSystem": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the request has a system prompt."
        },
        "toolResult": {
          "oneOf": [
            {
              "$ref": "#/$defs/ToolResultMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "A tool result the request sends back, from any turn."
        },
        "tools": {
          "oneOf": [
            {
              "$ref": "#/$defs/ToolsMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The declared tools and the tool choice."
        },
        "body": {
          "oneOf": [
            {
              "$ref": "#/$defs/BodyMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "A value in the request body."
        },
        "header": {
          "oneOf": [
            {
              "$ref": "#/$defs/HeaderMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "A request header."
        }
      }
    },
    "ParallelSection": {
      "type": "object",
      "description": "The responses of a parallel step. A call takes the first open step whose `match` it\nsatisfies, in listed order; a step with no `match` matches any call. A step is open until it\nhas its calls: one, or `times.max`. The scenario moves past the section once every step in it\nis at its maximum, or, once every step has its `times.min` calls, when a call it can't take\nreaches the step after it.\n",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Step"
              },
              {
                "not": {
                  "required": [
                    "parallel"
                  ],
                  "properties": {
                    "parallel": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          },
          "description": "The responses, each a plain step with an optional `match` and `times`. A parallel step can't hold another."
        },
        "overlap": {
          "type": "boolean",
          "default": false,
          "description": "Joins this section with the consecutive sections after it that also set it, into one\ngroup whose unused steps a call searches together, first match in listed order. The group\nends at the first step that is not such a section.\n"
        }
      }
    },
    "Times": {
      "type": "object",
      "description": "How many calls a step takes: at least `min` and at most `max`. Below `min` the step counts as\nunused; at `max` it closes, and the scenario moves past it once the steps around it at the\nscenario's position are closed too. Between the two, a call the step can't take moves on to\nthe step after it. `max` must be at least `min`, which the server checks when\nthe scenario loads (JSON Schema can't compare two values).\n",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 1,
          "description": "The fewest calls the step must get."
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647,
          "description": "The most calls the step can take; null, the default, is unbounded."
        }
      }
    },
    "TextMatch": {
      "type": "object",
      "description": "A rule on a text: exactly one of `contains`, `equals` and `regex`, case-sensitive. `regex`\nis a Java regular expression that may match anywhere; `^` and `$` anchor it.\n",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "contains"
          ],
          "properties": {
            "contains": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "equals"
          ],
          "properties": {
            "equals": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "regex"
          ],
          "properties": {
            "regex": {
              "type": "string"
            }
          }
        }
      ],
      "properties": {
        "contains": {
          "type": [
            "string",
            "null"
          ],
          "description": "The text contains this."
        },
        "equals": {
          "type": [
            "string",
            "null"
          ],
          "description": "The text is exactly this."
        },
        "regex": {
          "type": [
            "string",
            "null"
          ],
          "description": "This regular expression matches somewhere in the text."
        }
      }
    },
    "MessageMatch": {
      "type": "object",
      "description": "A rule on one message, chosen by exactly one of `index` and `role`, with exactly one of\n`contains`, `equals` and `regex` on its text.\n",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "index"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                }
              }
            },
            {
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "contains"
              ],
              "properties": {
                "contains": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "equals"
              ],
              "properties": {
                "equals": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "regex"
              ],
              "properties": {
                "regex": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ],
