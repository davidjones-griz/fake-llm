{
  "$schema": "../../schema/case.schema.json",
  "name": "poll-loop",
  "description": "A step with times min 1 and no max takes every status call; the first call it does not match reaches the next step. The call log numbers each use.",
  "scenario": {
    "name": "poll-loop",
    "steps": [
      {
        "match": {
          "lastUser": {
            "equals": "status?"
          }
        },
        "text": "Still running.",
        "times": {
          "min": 1
        }
      },
      {
        "match": {
          "lastUser": {
            "equals": "result?"
          }
        },
        "text": "Done."
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "status?"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-1",
          "type": "message",
          "role": "assistant",
          "model": "example-model",
