{
  "$schema": "../../schema/case.schema.json",
  "name": "min-zero-skipped",
  "description": "A step with times min 0 counts as used with no call, so the first call can reach the step after it.",
  "scenario": {
    "metadata": { "name": "retry-that-never-comes" },
    "steps": [
      {
        "match": {
          "lastUser": {
            "equals": "retry"
          }
        },
        "text": "Retried.",
        "times": {
          "min": 0,
          "max": 2
        }
      },
      {
        "match": {
          "lastUser": {
            "equals": "ok"
          }
        },
        "text": "OK."
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "status": "ok",
          "scenario": "retry-that-never-comes",
          "scenarioName": "retry-that-never-comes",
          "scenarioSource": "inline",
          "lenient": false,
          "steps": 2,
          "unusedSteps": [
            2
          ],
          "unusedStepNames": {},
          "version": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "ok"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-1",
          "type": "message",
          "role": "assistant",
          "model": "example-model",
          "content": [
            {
              "type": "text",
              "text": "OK."
            }
          ],
          "stop_reason": "end_turn",
          "stop_sequence": null,
          "usage": {
            "input_tokens": 100,
            "output_tokens": 50,
            "cache_read_input_tokens": 0,
            "cache_creation_input_tokens": 0
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "status": "ok",
          "scenario": "retry-that-never-comes",
          "scenarioName": "retry-that-never-comes",
          "scenarioSource": "inline",
          "lenient": false,
          "steps": 2,
          "unusedSteps": [],
          "unusedStepNames": {},
          "version": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
