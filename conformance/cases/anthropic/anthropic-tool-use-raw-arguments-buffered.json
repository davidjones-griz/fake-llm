{
  "$schema": "../../schema/case.schema.json",
  "name": "anthropic-tool-use-raw-arguments-buffered",
  "description": "A buffered request whose next step has rawArguments gets the exception 400 and is not a call; the step stays next, and a streamed request then gets it as call 1.",
  "scenario": {
    "name": "anthropic-tool-use-raw-arguments-buffered",
    "steps": [
      {
        "toolCalls": [
          {
            "name": "get_weather",
            "rawArguments": "{\"city\": Paris}"
          }
        ],
        "streamChunkChars": 8
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "exception",
          "detail": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": []
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message_start",
            "data": {
              "type": "message_start",
              "message": {
                "id": "fake-msg-1",
                "type": "message",
                "role": "assistant",
                "model": "example-model",
                "content": [],
                "stop_reason": null,
                "stop_sequence": null,
                "usage": {
                  "input_tokens": 100,
                  "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0
                }
              }
            }
          },
          {
            "event": "content_block_start",
            "data": {
              "type": "content_block_start",
              "index": 0,
              "content_block": {
                "type": "tool_use",
                "id": "toolu_fake_1_1",
                "name": "get_weather",
                "input": {}
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "input_json_delta",
                "partial_json": "{\"city\":"
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "input_json_delta",
                "partial_json": " Paris}"
              }
            }
          },
          {
            "event": "content_block_stop",
            "data": {
              "type": "content_block_stop",
              "index": 0
            }
          },
          {
            "event": "message_delta",
            "data": {
              "type": "message_delta",
              "delta": {
                "stop_reason": "tool_use",
                "stop_sequence": null
              },
              "usage": {
                "output_tokens": 50
              }
            }
          },
          {
            "event": "message_stop",
            "data": {
              "type": "message_stop"
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "anthropic",
            "model": "example-model",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "tool-calls",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": 1,
            "toolCalls": [
              {
                "id": "toolu_fake_1_1",
                "name": "get_weather"
              }
            ],
            "toolResults": []
          }
        ]
      }
    }
  ]
}
