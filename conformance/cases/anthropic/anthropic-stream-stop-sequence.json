{
  "$schema": "../../schema/case.schema.json",
  "name": "anthropic-stream-stop-sequence",
  "description": "Streamed, message_start keeps stop_sequence null and message_delta carries the step's stopSequence.",
  "scenario": {
    "name": "anthropic-stream-stop-sequence",
    "steps": [
      {
        "text": "42",
        "stopReason": "stop_sequence",
        "stopSequence": "</answer>"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 256,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message_start",
            "data": {
              "type": "message_start",
              "message": {
                "id": "fake-msg-1",
                "type": "message",
                "role": "assistant",
                "model": "example-model",
                "content": [],
                "stop_reason": null,
                "stop_sequence": null,
                "usage": {
                  "input_tokens": 100,
                  "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0
                }
              }
            }
          },
          {
            "event": "content_block_start",
            "data": {
              "type": "content_block_start",
              "index": 0,
              "content_block": {
                "type": "text",
                "text": ""
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "text_delta",
                "text": "42"
              }
            }
          },
          {
            "event": "content_block_stop",
            "data": {
              "type": "content_block_stop",
              "index": 0
            }
          },
          {
            "event": "message_delta",
            "data": {
              "type": "message_delta",
              "delta": {
                "stop_reason": "stop_sequence",
                "stop_sequence": "</answer>"
              },
              "usage": {
                "output_tokens": 50
              }
            }
          },
          {
            "event": "message_stop",
            "data": {
              "type": "message_stop"
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "anthropic",
            "model": "example-model",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "text",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": 1,
            "toolCalls": [],
            "toolResults": [],
            "firstByteDelayMs": 0,
            "streamInterChunkDelayMs": 0
          }
        ]
      }
    }
  ]
}
