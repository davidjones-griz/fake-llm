{
  "$schema": "../../schema/case.schema.json",
  "name": "anthropic-stream-error-after-chunks",
  "description": "streamErrorAfterChunks sends that many filler deltas, then the error body as an error event.",
  "scenario": {
    "name": "stream-error",
    "steps": [
      {
        "error": {
          "status": 529,
          "body": "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}"
        },
        "streamErrorAfterChunks": 2,
        "streamChunkChars": 10
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message_start",
            "data": {
              "type": "message_start",
              "message": {
                "id": "fake-msg-1",
                "type": "message",
                "role": "assistant",
                "model": "example-model",
                "content": [],
                "stop_reason": null,
                "stop_sequence": null,
                "usage": {
                  "input_tokens": 100,
                  "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0
                }
              }
            }
          },
          {
            "event": "content_block_start",
            "data": {
              "type": "content_block_start",
              "index": 0,
              "content_block": {
                "type": "text",
                "text": ""
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "text_delta",
                "text": "Thinking t"
              }
            }
          },
          {
            "event": "content_block_delta",
            "data": {
              "type": "content_block_delta",
              "index": 0,
              "delta": {
                "type": "text_delta",
                "text": "his throug"
              }
            }
          },
          {
            "event": "error",
            "data": {
              "type": "error",
              "error": {
                "type": "overloaded_error",
                "message": "Overloaded"
              }
            }
          }
        ]
      }
    }
  ]
}
