{
  "$schema": "../../schema/case.schema.json",
  "name": "section-in-any-order",
  "description": "Three calls take a parallel step's three steps in the order they arrive, each by its own match; the merge call, on another route, then takes the next step. The call log names each call's step and inner step.",
  "scenario": {
    "name": "summarize-three-then-merge",
    "steps": [
      {
        "parallel": {
          "steps": [
            {
              "match": {
                "lastUser": {
                  "contains": "doc-a"
                }
              },
              "text": "Summary of A."
            },
            {
              "match": {
                "lastUser": {
                  "contains": "doc-b"
                }
              },
              "text": "Summary of B."
            },
            {
              "match": {
                "lastUser": {
                  "contains": "doc-c"
                }
              },
              "text": "Summary of C."
            }
          ]
        }
      },
      {
        "match": {
          "system": {
            "contains": "Merge"
          }
        },
        "text": "A, B and C, combined."
      }
    ]
  },
