{
  "$schema": "../../schema/case.schema.json",
  "name": "no-match",
  "description": "A call that matches none of the steps it could take gets the no-match 400 with its call fields, takes a number and a log entry, and uses nothing: a plain step with a match stays next, and a partly used parallel step stays unused.",
  "scenario": {
    "name": "plain-match",
    "steps": [
      {
        "match": {
          "lastUser": {
            "equals": "first"
          }
        },
        "text": "one"
      },
      {
        "parallel": {
          "steps": [
            {
              "match": {
                "lastUser": {
                  "contains": "x"
                }
              },
              "text": "X"
            },
            {
              "match": {
                "lastUser": {
                  "contains": "y"
                }
              },
              "text": "Y"
            }
          ]
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "second"
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "no-match",
          "message": {
            "$type": "string"
          },
          "seq": 1,
          "vendor": "anthropic",
          "model": "example-model",
          "system_shape": "absent",
          "message_count": 1,
          "prompt_preview": "second\n"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
