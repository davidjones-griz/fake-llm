          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "first"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-2",
          "type": "message",
          "role": "assistant",
          "model": "example-model",
          "content": [
