{
  "$schema": "../../schema/case.schema.json",
  "name": "usage-partial-and-zero",
  "description": "An unset count keeps its default (100 input tokens), and zero counts are allowed; the total is the sum.",
  "scenario": {
    "name": "partial-and-zero",
    "steps": [
      {
        "text": "Partial.",
        "usage": {
          "outputTokens": 4000
        }
      },
      {
        "text": "Zero.",
        "usage": {
          "inputTokens": 0,
          "outputTokens": 0
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-openai-1",
          "object": "chat.completion",
          "model": "example-gpt",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Partial."
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 4000,
            "total_tokens": 4100
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-openai-2",
          "object": "chat.completion",
          "model": "example-gpt",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Zero."
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0
          }
        }
      }
    }
  ]
}
