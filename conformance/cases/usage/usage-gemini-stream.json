{
  "$schema": "../../schema/case.schema.json",
  "name": "usage-gemini-stream",
  "description": "A Gemini stream reports the step's counts in usageMetadata on its last chunk only.",
  "scenario": {
    "name": "gemini-stream-text",
    "steps": [
      {
        "text": "Mild and dry tomorrow.",
        "streamChunkChars": 8,
        "usage": {
          "inputTokens": 1200,
          "outputTokens": 340
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:streamGenerateContent?alt=sse",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "Mild and"
                      }
                    ]
                  }
                }
              ],
              "modelVersion": "example-gemini",
              "fake_llm_seq": 1
            }
          },
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": " dry tom"
                      }
                    ]
                  }
                }
              ],
              "modelVersion": "example-gemini",
              "fake_llm_seq": 1
            }
          },
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "orrow."
                      }
                    ]
                  },
                  "finishReason": "STOP"
                }
              ],
              "usageMetadata": {
                "promptTokenCount": 1200,
                "candidatesTokenCount": 340,
                "totalTokenCount": 1540
              },
              "modelVersion": "example-gemini",
              "fake_llm_seq": 1
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "gemini",
            "model": "example-gemini",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "text",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": 1,
            "toolCalls": [],
            "toolResults": [],
            "firstByteDelayMs": 0,
            "streamInterChunkDelayMs": 0
          }
        ]
      }
    }
  ]
}
