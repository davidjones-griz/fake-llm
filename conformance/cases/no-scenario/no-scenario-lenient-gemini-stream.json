{
  "$schema": "../../schema/case.schema.json",
  "name": "no-scenario-lenient-gemini-stream",
  "description": "With no scenario loaded, lenient mode streams the canned reply to a streamed Gemini request.",
  "server": {
    "lenient": true,
    "fresh": true
  },
  "scenario": null,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:streamGenerateContent?alt=sse",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "This is a canned respons"
                      }
                    ]
                  }
                }
              ],
              "fake_llm_seq": 1
            }
          },
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "e from fake-llm."
                      }
                    ]
                  },
                  "finishReason": "STOP"
                }
              ],
              "usageMetadata": {
                "promptTokenCount": 100,
                "candidatesTokenCount": 50,
                "totalTokenCount": 150
              },
              "fake_llm_seq": 1
            }
          }
        ]
      }
    }
  ]
}
