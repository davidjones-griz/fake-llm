{
  "$schema": "../../schema/case.schema.json",
  "name": "load-invalid-inline",
  "description": "Loading an inline scenario with no steps is a 400.",
  "scenario": "hello",
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/control/scenario",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "scenario": {
            "name": "empty",
            "steps": []
          }
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "exception",
          "detail": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
