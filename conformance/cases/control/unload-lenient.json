{
  "$schema": "../../schema/case.schema.json",
  "name": "unload-lenient",
  "description": "After unload, a lenient server answers the canned reply and logs it as default.",
  "server": {
    "lenient": true
  },
  "scenario": {
    "name": "two-steps",
    "steps": [
      {
        "text": "first"
      },
      {
        "text": "second"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/control/unload",
        "headers": {}
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "unloaded": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "status": "ok",
          "scenario": null,
          "lenient": true,
          "steps": null,
          "unusedSteps": []
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-1",
          "type": "message",
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "This is a canned response from fake-llm."
            }
          ],
          "stop_reason": "end_turn",
          "usage": {
            "input_tokens": 100,
            "output_tokens": 50,
            "cache_read_input_tokens": 0,
            "cache_creation_input_tokens": 0
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "anthropic",
            "model": "example-model",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "default",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": null,
            "toolCalls": [],
            "toolResults": [],
            "firstByteDelayMs": 0,
            "streamInterChunkDelayMs": 0
          }
        ]
      }
    }
  ]
}
