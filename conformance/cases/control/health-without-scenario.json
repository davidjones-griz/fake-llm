{
  "$schema": "../../schema/case.schema.json",
  "name": "health-without-scenario",
  "description": "GET /health reports no scenario, and the server's version, on a new server.",
  "server": {
    "fresh": true
  },
  "scenario": null,
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "status": "ok",
          "scenario": null,
          "scenarioName": null,
          "scenarioSource": null,
          "lenient": false,
          "steps": null,
          "unusedSteps": [],
          "unusedStepNames": {},
          "version": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
