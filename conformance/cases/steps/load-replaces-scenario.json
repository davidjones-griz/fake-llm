{
  "$schema": "../../schema/case.schema.json",
  "name": "load-replaces-scenario",
  "description": "Loading another scenario replaces the loaded one, empties the call log, and starts at its step 1.",
  "scenario": {
    "name": "old",
    "steps": [
      {
        "text": "old one"
      },
      {
        "text": "old two"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-1",
          "type": "message",
          "role": "assistant",
          "model": "example-model",
          "content": [
            {
              "type": "text",
              "text": "old one"
            }
          ],
          "stop_reason": "end_turn",
          "stop_sequence": null,
          "usage": {
            "input_tokens": 100,
            "output_tokens": 50,
            "cache_read_input_tokens": 0,
            "cache_creation_input_tokens": 0
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/control/scenario",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "scenario": {
            "name": "new",
            "steps": [
              {
                "text": "new one"
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "loaded": "new",
          "steps": 1
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": []
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 64,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "fake-msg-1",
          "type": "message",
          "role": "assistant",
          "model": "example-model",
          "content": [
            {
              "type": "text",
              "text": "new one"
            }
          ],
          "stop_reason": "end_turn",
          "stop_sequence": null,
          "usage": {
            "input_tokens": 100,
            "output_tokens": 50,
            "cache_read_input_tokens": 0,
            "cache_creation_input_tokens": 0
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "status": "ok",
          "scenario": "new",
          "lenient": false,
          "steps": 1,
          "unusedSteps": [],
          "version": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
