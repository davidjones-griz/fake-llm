{
  "$schema": "../../schema/case.schema.json",
  "name": "count-tokens",
  "description": "POST /anthropic/v1/messages/count_tokens answers input_tokens 100 for a body the Messages route accepts, and the invalid-request 400 for one it rejects. It is not a call, so it needs no scenario and is not logged.",
  "server": {
    "fresh": true
  },
  "scenario": null,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages/count_tokens",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model",
          "max_tokens": 256,
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input_tokens": 100
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/anthropic/v1/messages/count_tokens",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-model"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "invalid-request",
          "message": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": []
      }
    }
  ]
}
