{
  "$schema": "../../schema/case.schema.json",
  "name": "first-byte-delay-openai-stream",
  "description": "A first-byte and inter-chunk delay leave an OpenAI Chat Completions stream unchanged, and the call log records (50, 20).",
  "scenario": {
    "name": "stream-text",
    "steps": [
      {
        "text": "Mild and dry tomorrow.",
        "streamChunkChars": 8,
        "firstByteDelayMs": 50,
        "streamInterChunkDelayMs": 20
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "fake-openai",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": ""
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "fake-openai",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "Mild and"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "fake-openai",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": " dry tom"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "fake-openai",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "orrow."
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "fake-openai",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "event": "message",
            "data": "[DONE]"
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "openai",
            "model": "example-gpt",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "text",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": 1,
            "toolCalls": [],
            "toolResults": [],
            "firstByteDelayMs": 50,
            "streamInterChunkDelayMs": 20
          }
        ]
      }
    }
  ]
}
