{
  "$schema": "../../schema/case.schema.json",
  "name": "first-byte-delay-stream-error-after-chunks",
  "description": "A first-byte and inter-chunk delay leave an in-stream error unchanged, and the call log records (50, 20).",
  "scenario": {
    "name": "stream-error-after-chunks",
    "steps": [
      {
        "error": {
          "status": 500,
          "body": "{\"error\":{\"message\":\"server error\",\"type\":\"server_error\",\"param\":null,\"code\":null}}"
        },
        "streamErrorAfterChunks": 2,
        "streamChunkChars": 10,
        "firstByteDelayMs": 50,
        "streamInterChunkDelayMs": 20
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": ""
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "Thinking t"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "his throug"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "error": {
                "message": "server error",
                "type": "server_error",
                "param": null,
                "code": null
              }
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "vendor": "openai",
            "model": "example-gpt",
            "systemShape": "absent",
            "messageCount": 1,
            "outcome": "error:500",
            "timestampMs": {
              "$type": "integer"
            },
            "promptSample": "Hello\n",
            "step": 1,
            "toolCalls": [],
            "toolResults": [],
            "firstByteDelayMs": 50,
            "streamInterChunkDelayMs": 20
          }
        ]
      }
    }
  ]
}
