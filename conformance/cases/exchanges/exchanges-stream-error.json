{
  "$schema": "../../schema/case.schema.json",
  "name": "exchanges-stream-error",
  "description": "A mid-stream error is recorded up to and including the error frame.",
  "scenario": {
    "name": "stream-error",
    "steps": [
      {
        "error": {
          "status": 500,
          "body": "{\"error\":{\"code\":500,\"message\":\"server error\",\"status\":\"INTERNAL\"}}"
        },
        "streamErrorAfterChunks": 2,
        "streamChunkChars": 10
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:streamGenerateContent?alt=sse",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "Thinking t"
                      }
                    ]
                  }
                }
              ],
              "fake_llm_seq": 1
            }
          },
          {
            "event": "message",
            "data": {
              "candidates": [
                {
                  "content": {
                    "role": "model",
                    "parts": [
                      {
                        "text": "his throug"
                      }
                    ]
                  }
                }
              ],
              "fake_llm_seq": 1
            }
          },
          {
            "event": "message",
            "data": {
              "error": {
                "code": 500,
                "message": "server error",
                "status": "INTERNAL"
              }
            }
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/exchanges"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "request": {
              "method": "POST",
              "path": "/gemini/v1beta/models/example-gemini:streamGenerateContent?alt=sse",
              "headers": {
                "$type": "object"
              },
              "body": "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": [
                  "no-cache"
                ],
                "connection": [
                  "keep-alive"
                ],
                "content-type": [
                  "text/event-stream"
                ]
              },
              "body": "data: {\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"text\":\"Thinking t\"}]}}],\"fake_llm_seq\":1}\n\ndata: {\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"text\":\"his throug\"}]}}],\"fake_llm_seq\":1}\n\ndata: {\"error\":{\"code\":500,\"message\":\"server error\",\"status\":\"INTERNAL\"}}\n\n",
              "state": "complete"
            }
          }
        ]
      }
    }
  ]
}
