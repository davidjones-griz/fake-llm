{
  "$schema": "../../schema/case.schema.json",
  "name": "exchanges-key-redacted",
  "description": "A key query parameter is recorded as key=[redacted].",
  "scenario": {
    "name": "key-redacted",
    "steps": [
      {
        "text": "Hi."
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:generateContent?key=secret-key",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "candidates": [
            {
              "content": {
                "role": "model",
                "parts": [
                  {
                    "text": "Hi."
                  }
                ]
              },
              "finishReason": "STOP"
            }
          ],
          "usageMetadata": {
            "promptTokenCount": 100,
            "candidatesTokenCount": 50,
            "totalTokenCount": 150
          },
          "fake_llm_seq": 1
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/exchanges"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "request": {
              "method": "POST",
              "path": "/gemini/v1beta/models/example-gemini:generateContent?key=[redacted]",
              "headers": {
                "$type": "object"
              },
              "body": "{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Hello\"}]}]}"
            },
            "response": {
              "status": 200,
              "headers": {
                "content-type": [
                  "application/json"
                ]
