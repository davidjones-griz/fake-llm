{
  "$schema": "../../schema/case.schema.json",
  "name": "exchanges-scripted-error",
  "description": "A scripted error is recorded with its status, scripted headers and body.",
  "scenario": {
    "name": "scripted-error",
    "steps": [
      {
        "error": {
          "status": 429,
          "body": "{\"error\":{\"message\":\"slow down\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}",
          "headers": {
            "retry-after": "1"
          }
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "input": "Hello"
        }
      },
      "response": {
        "status": 429,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "error": {
            "message": "slow down",
            "type": "requests",
            "param": null,
            "code": "rate_limit_exceeded"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/exchanges"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "request": {
              "method": "POST",
              "path": "/openai/v1/responses",
              "headers": {
                "$type": "object"
              },
              "body": "{\"model\":\"example-gpt\",\"input\":\"Hello\"}"
            },
            "response": {
              "status": 429,
              "headers": {
                "content-type": [
                  "application/json"
                ],
                "retry-after": [
                  "1"
                ]
              },
              "body": "{\"error\":{\"message\":\"slow down\",\"type\":\"requests\",\"param\":null,\"code\":\"rate_limit_exceeded\"}}",
              "state": "complete"
            }
          }
        ]
      }
    }
  ]
}
