{
  "$schema": "../../schema/case.schema.json",
  "name": "exchanges-stream",
  "description": "A streamed call's exchange holds the whole event stream, ending with data: [DONE].",
  "scenario": {
    "name": "stream",
    "steps": [
      {
        "text": "Mild and dry tomorrow.",
        "streamChunkChars": 8
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/chat/completions",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ],
          "stream": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream"
        },
        "events": [
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "role": "assistant",
                    "content": ""
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "Mild and"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": " dry tom"
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {
                    "content": "orrow."
                  },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "event": "message",
            "data": {
              "id": "fake-openai-1",
              "object": "chat.completion.chunk",
              "model": "example-gpt",
              "choices": [
                {
                  "index": 0,
                  "delta": {},
                  "finish_reason": "stop"
                }
              ]
            }
          },
          {
            "event": "message",
            "data": "[DONE]"
          }
        ]
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/exchanges"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "seq": 1,
            "request": {
              "method": "POST",
              "path": "/openai/v1/chat/completions",
              "headers": {
                "$type": "object"
              },
              "body": "{\"model\":\"example-gpt\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"stream\":true}"
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": [
                  "no-cache"
                ],
                "connection": [
                  "keep-alive"
                ],
                "content-type": [
                  "text/event-stream"
                ]
              },
              "body": "data: {\"id\":\"fake-openai-1\",\"object\":\"chat.completion.chunk\",\"model\":\"example-gpt\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"fake-openai-1\",\"object\":\"chat.completion.chunk\",\"model\":\"example-gpt\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Mild and\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"fake-openai-1\",\"object\":\"chat.completion.chunk\",\"model\":\"example-gpt\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\" dry tom\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"fake-openai-1\",\"object\":\"chat.completion.chunk\",\"model\":\"example-gpt\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"orrow.\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"fake-openai-1\",\"object\":\"chat.completion.chunk\",\"model\":\"example-gpt\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n",
              "state": "complete"
            }
          }
        ]
      }
    }
  ]
}
