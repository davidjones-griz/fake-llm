{
  "$schema": "../../schema/case.schema.json",
  "name": "control-routes-without-token",
  "description": "With a control token set, each control route without it is a 401 with WWW-Authenticate: Bearer.",
  "server": {
    "controlToken": "conformance-token"
  },
  "scenario": "hello",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/control/calls"
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer"
        },
        "body": {
          "fake_llm_error": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/scenarios"
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer"
        },
        "body": {
          "fake_llm_error": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/control/reset",
        "headers": {}
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer"
        },
        "body": {
          "fake_llm_error": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/control/scenario",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "name": "hello"
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer"
        },
        "body": {
          "fake_llm_error": {
            "$type": "string"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/control/nope"
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json",
          "www-authenticate": "Bearer"
        },
        "body": {
          "fake_llm_error": {
            "$type": "string"
          }
        }
      }
    }
  ]
}
