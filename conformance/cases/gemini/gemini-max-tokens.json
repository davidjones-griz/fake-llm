{
  "$schema": "../../schema/case.schema.json",
  "name": "gemini-max-tokens",
  "description": "stopReason max_tokens becomes finishReason MAX_TOKENS.",
  "scenario": {
    "name": "cutoff",
    "steps": [
      {
        "text": "The recipe is",
        "stopReason": "max_tokens"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:generateContent",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "candidates": [
            {
              "content": {
                "role": "model",
                "parts": [
                  {
                    "text": "The recipe is"
                  }
                ]
              },
              "finishReason": "MAX_TOKENS"
            }
          ],
          "usageMetadata": {
            "promptTokenCount": 100,
            "candidatesTokenCount": 50,
            "totalTokenCount": 150
          },
          "modelVersion": "example-gemini",
          "fake_llm_seq": 1
        }
      }
    }
  ]
}
