{
  "$schema": "../../schema/case.schema.json",
  "name": "gemini-stream-no-more-steps",
  "description": "A streamed call after the last step gets the JSON no-more-steps 400, with no event stream.",
  "scenario": {
    "name": "gemini-stream-no-more-steps",
    "steps": [
      {
        "text": "only"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:generateContent",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "candidates": [
            {
              "content": {
                "role": "model",
                "parts": [
                  {
                    "text": "only"
                  }
                ]
              },
              "finishReason": "STOP"
            }
          ],
          "usageMetadata": {
            "promptTokenCount": 100,
            "candidatesTokenCount": 50,
            "totalTokenCount": 150
          },
          "modelVersion": "example-gemini",
          "fake_llm_seq": 1
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/gemini/v1beta/models/example-gemini:streamGenerateContent?alt=sse",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Again"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "no-more-steps",
          "message": {
            "$type": "string"
          },
          "scenario": "gemini-stream-no-more-steps",
          "steps": 1,
          "seq": 2,
          "vendor": "gemini",
          "model": "example-gemini",
          "system_shape": "absent",
          "message_count": 1,
          "prompt_preview": "Again\n"
        }
      }
    }
  ]
}
