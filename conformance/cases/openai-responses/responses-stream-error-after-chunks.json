{
  "$schema": "../../schema/case.schema.json",
  "name": "responses-stream-error-after-chunks",
  "description": "streamErrorAfterChunks opens the message, sends that many filler deltas, then event error with the scripted body, and nothing after it.",
  "scenario": {
    "name": "responses-stream-error-after-chunks",
    "steps": [
      {
        "error": {
          "status": 500,
          "body": "{\"error\":{\"message\":\"server error\",\"type\":\"server_error\",\"param\":null,\"code\":null}}"
        },
        "streamErrorAfterChunks": 2,
        "streamChunkChars": 10
      }
    ]
  },
