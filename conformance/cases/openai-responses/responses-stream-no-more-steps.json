{
  "$schema": "../../schema/case.schema.json",
  "name": "responses-stream-no-more-steps",
  "description": "A streamed call after the last step gets the JSON no-more-steps 400 with vendor openai-responses, and no event stream.",
  "scenario": {
    "name": "responses-stream-no-more-steps",
    "steps": [
      {
        "text": "only"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "input": "Hello"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "id": "resp_fake_1",
          "object": "response",
          "status": "completed",
          "error": null,
          "incomplete_details": null,
          "model": "example-gpt",
          "output": [
            {
              "id": "msg_fake_1",
              "type": "message",
              "status": "completed",
              "role": "assistant",
              "content": [
                {
                  "type": "output_text",
                  "text": "only",
                  "annotations": []
                }
              ]
            }
          ],
          "parallel_tool_calls": true,
          "tool_choice": "auto",
          "tools": [],
          "usage": {
            "input_tokens": 100,
            "input_tokens_details": {
              "cached_tokens": 0
            },
            "output_tokens": 50,
            "output_tokens_details": {
              "reasoning_tokens": 0
            },
            "total_tokens": 150
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/openai/v1/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "model": "example-gpt",
          "input": "Again",
          "stream": true
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "fake_llm_error": "no more steps",
          "scenario": "responses-stream-no-more-steps",
          "steps": 1,
          "seq": 2,
          "vendor": "openai-responses",
          "model": "example-gpt",
          "system_shape": "absent",
          "message_count": 1,
          "prompt_preview": "Again\n"
        }
      }
    }
  ]
}
