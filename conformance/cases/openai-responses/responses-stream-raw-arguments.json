{
  "$schema": "../../schema/case.schema.json",
  "name": "responses-stream-raw-arguments",
  "description": "A streamed tool call without text starts at output_index 0 and sends rawArguments verbatim.",
  "scenario": {
    "name": "responses-stream-raw-arguments",
    "steps": [
      {
        "toolCalls": [
          {
            "name": "get_weather",
            "rawArguments": "{\"city\": Paris}",
            "id": "call_custom"
          }
        ],
        "streamChunkChars": 8
      }
    ]
  },
