{
  "name": "fake-llm-sdk-conformance-node",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "test": "mkdir -p reports && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/${FAKE_LLM_REPORT:-local}.xml \"*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.32.0",
    "@types/node": "26.6.6",
    "openai": "7.45.1",
    "typescript": "7.0.2"
  }
}
